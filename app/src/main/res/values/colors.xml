<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The one place a colour literal is allowed to live outside MomoColors.kt:
      the window theme is inflated by the platform before Compose runs and
      cannot read a Kotlin constant. Value is Surface / Cream (#FDF3E7), the
      canvas fill every REAL coded frame uses (A2.0/B1.0/J2.0/N8.0/F3.0), kept
      in step with MomoColors.SurfaceCanvas.
    -->
    <color name="window_background">#FDF3E7</color>

    <!--
      Adaptive launcher-icon background (mipmap-anydpi-v26). Warm cream, so the
      mascot badge's brown (#793000) and white rings read cleanly and nothing is
      clipped under any launcher mask shape. Generated by
      tools/make_launcher_icons.py.
    -->
    <color name="ic_launcher_background">#FFF8E7</color>
</resources>
